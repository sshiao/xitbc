# Your Comfy API key, from https://platform.comfy.org/profile/api-keys
# The same key runs every Comfy workflow: FLUX.2 images, LTX-2.5 clips and the Sonilo score.
COMFY_API_KEY=

# Optional. Leave this blank to run the workflows on Comfy Cloud.
# Set it to a Comfy Developer Platform deployment URL to run them there instead.
COMFY_BASE_URL=

# Optional. Set to 1 to run the whole pipeline locally with ffmpeg: no Comfy calls and no credits.
XITBC_MOCK=

# Optional. A .ttf or .otf file for the title card. Leave this blank to use a serif font from the system.
XITBC_TITLE_FONT=
