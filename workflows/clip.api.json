{
  "still": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Storyboard still (first frame)"
    },
    "inputs": {
      "image": "still.png"
    }
  },
  "animate": {
    "class_type": "MinimaxHailuo03FirstLastFrameNode",
    "_meta": {
      "title": "MiniMax H3 first frame to video"
    },
    "inputs": {
      "model": "MiniMax H3",
      "model.prompt": "Use the provided start image as the first frame.",
      "model.resolution": "768P",
      "model.duration": 4,
      "first_frame": [
        "still",
        0
      ],
      "seed": 42,
      "watermark": false
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "_meta": {
      "title": "Save clip"
    },
    "inputs": {
      "video": [
        "animate",
        0
      ],
      "filename_prefix": "xitbc/clip",
      "format": "mp4",
      "format.codec": "h264"
    }
  }
}
